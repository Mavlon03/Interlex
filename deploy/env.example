# Interlex deploy settings. Nothing here is a real value.
# On the server the CI job writes /opt/interlex/.env from GitHub (repo → Settings → Environments → production):
#   [var]    = Environment variable    [secret] = Environment secret
# Never commit a filled-in copy of this file.

# ---- server / ports ----
COMPOSE_PROJECT_NAME=interlex
IMAGE=dockerhub-user/interlex:prod          # set by CI
APP_PORT=8095                               # [var] APP_PORT   127.0.0.1 port nginx proxies to
DB_PORT=5435                                # [var] DB_PORT    127.0.0.1 port of the project's own PostgreSQL

# ---- database ----
DB_NAME=interlex_db
DB_USERNAME=interlex
DB_PASSWORD=change-me                       # [secret] DB_PASSWORD   openssl rand -base64 24

# ---- application ----
SPRING_MAIL_USERNAME=you@gmail.com          # [var] MAIL_USERNAME
SPRING_MAIL_PASSWORD=change-me              # [secret] MAIL_PASSWORD  Gmail app password
JWT_SECRET=change-me                        # [secret] JWT_SECRET     openssl rand -base64 48
APP_ENCRYPTION_KEY=change-me                # [secret] APP_ENCRYPTION_KEY  openssl rand -base64 32
APP_ADMIN_EMAIL=admin@example.com           # [var] ADMIN_EMAIL
APP_ADMIN_PASSWORD=change-me                # [secret] ADMIN_PASSWORD  first admin password (8+ chars)
DDL_AUTO=update                             # [var] DDL_AUTO (optional) update | validate
